{
    "name": "kazmas",
    "version": "0.0.1",
    "private": true,
    "description": "The Kazmas App",
    "license": "Apache-2.0 OR MIT",
    "author": "duonghieu0712z",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "start": "pnpm tauri dev",
        "preview": "vite preview",
        "build": "run-p type-check \"build-only {@}\" --",
        "build-only": "vite build",
        "make": "pnpm tauri build",
        "type-check": "pnpm test:types",
        "lint": "run-s lint:check:*",
        "lint:fix": "run-s lint:fix:*",
        "lint:check:oxlint": "oxlint .",
        "lint:check:eslint": "eslint . --cache",
        "lint:fix:oxlint": "oxlint --fix .",
        "lint:fix:eslint": "eslint --fix . --cache",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt .",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:types": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
        "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
        "test:ui": "playwright test",
        "test:ui:update": "playwright test --update-snapshots",
        "test:desktop": "wdio run wdio.conf.ts",
        "test:desktop:build": "node scripts/build-desktop-tests.js",
        "bump": "node scripts/bump-version.js",
        "prepare": "husky"
    },
    "dependencies": {
        "@lucide/vue": "^1.61.0",
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-dialog": "^2.8.3",
        "@tauri-apps/plugin-opener": "^2.7.2",
        "@tauri-apps/plugin-os": "^2.4.0",
        "@tiptap/extension-character-count": "^3.32.0",
        "@tiptap/extension-code-block-lowlight": "^3.32.0",
        "@tiptap/extension-find-and-replace": "^3.32.0",
        "@tiptap/extension-invisible-characters": "^3.32.0",
        "@tiptap/extension-list": "^3.32.0",
        "@tiptap/extension-placeholder": "^3.32.0",
        "@tiptap/extension-ruby-text": "^3.32.0",
        "@tiptap/extension-subscript": "^3.32.0",
        "@tiptap/extension-superscript": "^3.32.0",
        "@tiptap/extension-text-align": "^3.32.0",
        "@tiptap/extension-unique-id": "^3.32.0",
        "@tiptap/pm": "^3.32.0",
        "@tiptap/starter-kit": "^3.32.0",
        "@tiptap/vue-3": "^3.32.0",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "highlight.js": "^11.12.0",
        "lowlight": "^3.3.0",
        "pinia": "^4.1.0",
        "reka-ui": "^2.11.0",
        "vue": "^3.5.44"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@pinia/testing": "^2.0.2",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.12.3",
        "@tsconfig/node24": "^24.0.5",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.5",
        "@typescript/native": "npm:typescript@~7.0.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^5.0.5",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "@wdio/cli": "^10.1.0",
        "@wdio/globals": "^10.1.0",
        "@wdio/local-runner": "^10.1.0",
        "@wdio/mocha-framework": "^10.1.0",
        "@wdio/spec-reporter": "^10.1.0",
        "@wdio/tauri-plugin": "^1.5.0",
        "@wdio/tauri-service": "^1.5.0",
        "@wdio/types": "^10.1.0",
        "eslint": "^10.13.0",
        "eslint-plugin-oxlint": "^1.89.0",
        "eslint-plugin-vue": "^10.11.1",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "npm-run-all2": "^9.0.4",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "oxlint-tsgolint": "^7.0.2005",
        "picomatch": "^4.0.7",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "npm:@typescript/typescript6@~6.0.2",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.3.5",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@12.10.1"
}
