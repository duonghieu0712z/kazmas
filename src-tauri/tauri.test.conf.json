{
    "identifier": "com.kazmas.desktop.tests",
    "build": {
        "beforeBuildCommand": "node scripts/build-desktop-tests.js --frontend-only",
        "frontendDist": "../.artifacts/desktop/frontend"
    },
    "app": {
        "withGlobalTauri": true,
        "security": {
            "capabilities": [
                "default",
                {
                    "identifier": "desktop-tests",
                    "windows": ["kazmas-window:*"],
                    "permissions": ["wdio:default"]
                }
            ]
        }
    }
}
